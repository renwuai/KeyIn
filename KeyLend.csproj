<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>KeyLend.ico</ApplicationIcon>
    <AssemblyName>KeyLend</AssemblyName>
    <Product>KeyIn</Product>
    <Version>0.1.18</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="KeyLend.ico" />
    <EmbeddedResource Include="LICENSE" LogicalName="KeyIn.LICENSE" />
    <EmbeddedResource Include="$(PortableNoticeFile)" LogicalName="KeyIn.THIRD-PARTY-NOTICES.txt" Condition="'$(PortableNoticeFile)' != ''" />
  </ItemGroup>
</Project>
